+#if defined(CONFIG_KSU_X86_PATCH_SYSCALL_DISPATCHER) && LINUX_VERSION_CODE < KERNEL_VERSION(5, 16, 0)
+/*
+ * 放在 .entry.text 里的跳板：内核 syscall 入口所有代码都在这个段，
+ * 这里发生的任何异常/抢占都由内核自己的入口栈与 fixup 处理。
+ * eax 里保留着系统调用号（原生 do_syscall_64 的约定）。
+ */
+asm(".pushsection .entry.text, \"ax\"\n"
+    ".global ksu_entry_trampoline\n"
+    "ksu_entry_trampoline:\n"
+    "   movq %rdi, %rax\n"
+    "   xchgl %eax, %ebx\n"
+    "   jmp *syscall_enter_rel32(%rip)\n"
+    ".global ksu_entry_trampoline_end\n"
+    "ksu_entry_trampoline_end:\n"
+    ".popsection\n");
+
+// 用入口跳板替换 do_syscall_64 的前 8 字节，同时校验入口指令是否与预期一致
+static void patch_do_syscall_64_entry(void)
+{
+    static const char expect[] = {
+        // movq %rdi, %rax ; xchgl %eax, %ebx ; call
+        0x48, 0x89, 0xf8, 0x93, 0xe8
+    };
+    char orig[8];
+    unsigned long enter;
+
+    do_syscall_64_patch_addr = (void *)find_kernel_symbol_exact("do_syscall_64");
+    enter = find_kernel_symbol_exact("syscall_enter_from_user_mode");
+    pr_info("do_syscall_64=0x%lx, syscall_enter_from_user_mode=0x%lx\n", (unsigned long)do_syscall_64_patch_addr,
+            enter);
+    if (!do_syscall_64_patch_addr || !enter)
+        return;
+
+    memcpy(orig, do_syscall_64_patch_addr, sizeof(orig));
+    if (memcmp(orig, expect, sizeof(expect)) != 0) {
+        pr_err("do_syscall_64 entry mismatch: %02x %02x %02x %02x %02x\n", (unsigned char)orig[0],
+               (unsigned char)orig[1], (unsigned char)orig[2], (unsigned char)orig[3], (unsigned char)orig[4]);
+        do_syscall_64_patch_addr = NULL;
+        return;
+    }
+
+    // 跳板尾部 jmp 的 rel32 = 目标 - 下一条指令地址
+    syscall_enter_rel32 = enter - ((unsigned long)ksu_entry_trampoline_end - 4);
+
+    // 备份：前 5 字节追加被覆盖掉的 call 剩余 3 字节
+    memcpy(do_syscall_64_orig_insn, orig, 5);
+    memcpy(do_syscall_64_orig_insn + 5, orig + 5, 3);
+
+    if (ksu_patch_text(do_syscall_64_patch_addr, ksu_entry_trampoline, 8, KSU_PATCH_TEXT_FLUSH_ICACHE)) {
+        pr_err("patch do_syscall_64 entry failed\n");
+        do_syscall_64_patch_addr = NULL;
+        return;
+    }
+    pr_info("do_syscall_64 entry patched -> trampoline\n");
+}
+#endif
